# Nexora AI local configuration
APP_NAME=Nexora AI
APP_ENV=development

# Default provider: mock | gemini | anthropic | ollama
# mock lets you test the UI without using an AI model. Change provider in the app header.
LLM_PROVIDER=mock

# Google AI Studio (Gemini)
# REPLACE this value with a newly-created key. Never commit a real API key.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.8-flash

# Anthropic Claude API
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-5-5

# Ollama local model. For image questions, use a vision-capable model.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:latest
OLLAMA_TIMEOUT_SECONDS=120

# Local application storage
DATABASE_URL=sqlite:///data/agent_harness.db
WORKSPACE_DIR=workspace
KNOWLEDGE_BASE_DIR=knowledge_base
LOG_DIR=logs
BENCHMARK_DATASET=benchmarks/tasks.json
MAX_TOOL_OUTPUT_CHARS=8000
MAX_WORKSPACE_FILE_BYTES=200000
MAX_AGENT_STEPS=5
REQUEST_TIMEOUT_SECONDS=120

# Optional API key to protect local API routes. Keep blank for local-only development.
API_KEY=
MAX_UPLOAD_MB=10
